---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPublishedNotes } from '../lib/content';

const notes = await getPublishedNotes();
---

<BaseLayout>
  <section class="shell home-index" aria-labelledby="posts-heading">
    <h1 id="posts-heading" class="sr-only">Posts</h1>
    <ol class="post-index">
      {notes.map((note) => (
        <li>
          <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          <time datetime={note.data.published.toISOString()}>{formatDate(note.data.published)}</time>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
