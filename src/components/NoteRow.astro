---
import type { Note } from '../lib/content';
import { formatDate } from '../lib/content';

interface Props {
  note: Note;
}

const { note } = Astro.props;
---

<article class="note-row">
  <time datetime={note.data.published.toISOString()}>{formatDate(note.data.published)}</time>
  <div>
    <h2><a href={`/notes/${note.id}/`}>{note.data.title}</a></h2>
  </div>
</article>
